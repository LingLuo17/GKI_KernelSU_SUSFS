# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
gki-android12-5.10=ac5719bc3f9578ba1add450b5fe8177e0b6cde2e
gki-android13-5.15=ac5719bc3f9578ba1add450b5fe8177e0b6cde2e
gki-android14-6.1=ac5719bc3f9578ba1add450b5fe8177e0b6cde2e
gki-android15-6.6=ac5719bc3f9578ba1add450b5fe8177e0b6cde2e
gki-android16-6.12=ac5719bc3f9578ba1add450b5fe8177e0b6cde2e

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=
